PORT=8081
NODE_ENV=production

# Supabase PostgreSQL: Project Settings > Database > Connection string > Session pooler (port 5432).
# Use the pooler, not the direct connection: the direct host is IPv6-only on the free tier.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: path to Supabase SSL certificate (Database > SSL configuration) to verify the server
DATABASE_CA=

# Same SECRET_KEY as the old server keeps current admin logins valid after cutover
SECRET_KEY=
# Signs password reset links. Long random string: openssl rand -hex 32
RESET_SECRET=

# Gmail account + app password for reset emails
MAIL_USER=
MAIL_PASS=

# Admin panel URL, used in reset links
ADMIN_URL=https://admin.amoxford.com

# Comma-separated origins allowed to call the API
CORS_ORIGINS=https://admin.amoxford.com,https://www.amoxford.com,http://localhost:5173,http://localhost:3000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=amoxford-images
# Public URL of the bucket (custom domain), no trailing slash
R2_PUBLIC_URL=https://images.amoxford.com

# Only for scripts/migrate-from-mongo.js
MONGO_URI=mongodb://127.0.0.1:27017/schooldatabase
