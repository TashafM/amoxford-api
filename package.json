{
  "name": "amoxford-api",
  "version": "2.0.0",
  "private": true,
  "description": "A.M. Oxford school API: Node.js + PostgreSQL + Cloudflare R2. Same endpoints as the old MongoDB server.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node src/guard.js",
    "migrate:mongo": "node scripts/migrate-from-mongo.js",
    "migrate:images": "node scripts/upload-images-to-r2.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pg": "^8.12.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "mongodb": "^6.8.0"
  }
}
